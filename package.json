{
  "name": "nyc-transit-hub",
  "version": "0.1.0",
  "description": "Real-time NYC subway and bus status, arrivals, accessibility and alerts, built on MTA open data feeds.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "sample": "USE_SAMPLE_DATA=1 node server/index.js",
    "build:stations": "node scripts/build-stations.js",
    "test": "node --test test/*.test.js",
    "demo": "node demo/build-demo.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "gtfs-realtime-bindings": "^1.1.1"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
