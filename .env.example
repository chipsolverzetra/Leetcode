# Port for the Express server
PORT=3000

# Subway GTFS-realtime, alerts and elevator/escalator feeds need no key.
# MTA Bus Time (SIRI) requires a free key: https://register.developer.obanyc.com/
MTA_BUS_API_KEY=

# How long (seconds) to cache upstream MTA responses. Subway feeds refresh about every 30s.
CACHE_TTL_SECONDS=30

# Set to 1 to serve bundled sample data instead of calling the MTA (offline demos, tests).
USE_SAMPLE_DATA=0
